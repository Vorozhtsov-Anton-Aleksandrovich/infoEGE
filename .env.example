# Скопируйте в .env на сервере и заполните: cp .env.example .env && chmod 600 .env
# Файл .env не коммитится. Пустые обязательные значения остановят запуск с понятной ошибкой.
# Случайный пароль: openssl rand -base64 24

# Домен (A-запись должна указывать на IP сервера) и почта для Let's Encrypt
DOMAIN=ege.example.ru
ACME_EMAIL=admin@example.ru

# Образ приложения. При сборке на сервере (docker compose ... up -d --build) оставьте infoege.
# Для деплоя через GitHub Actions: ghcr.io/<ваш-github-логин>/infoege (workflow сам обновит эти строки).
IMAGE=infoege
IMAGE_TAG=latest

# База данных
POSTGRES_DB=infoege
POSTGRES_USER=infoege
POSTGRES_PASSWORD=

# Аккаунт преподавателя: создаётся только при первом запуске на пустой БД.
# Пароль не короче 12 символов и не совпадает с логином, иначе приложение не запустится.
TEACHER_LOGIN=
TEACHER_PASSWORD=
TEACHER_NAME=Преподаватель

APP_TIMEZONE=Europe/Moscow
MAX_FILE_SIZE=20MB

# Бэкапы (scripts/backup.sh)
BACKUP_DIR=/var/backups/infoege
BACKUP_KEEP_DAYS=14
