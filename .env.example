# Скопируйте в .env на сервере и заполните. Файл .env не коммитится.

# Домен (A-запись должна указывать на VPS) и почта для Let's Encrypt
DOMAIN=ege.example.ru
ACME_EMAIL=admin@example.ru

# Образ приложения в GitHub Container Registry
IMAGE=ghcr.io/your-github-login/infoege
IMAGE_TAG=latest

# База данных: придумайте длинный случайный пароль (например, openssl rand -base64 24)
POSTGRES_DB=infoege
POSTGRES_USER=infoege
POSTGRES_PASSWORD=

# Аккаунт преподавателя: создаётся только при первом запуске на пустой БД
TEACHER_LOGIN=teacher
TEACHER_PASSWORD=
TEACHER_NAME=Преподаватель

APP_TIMEZONE=Europe/Moscow
MAX_FILE_SIZE=20MB

# Бэкапы (scripts/backup.sh)
BACKUP_DIR=/var/backups/infoege
BACKUP_KEEP_DAYS=14
