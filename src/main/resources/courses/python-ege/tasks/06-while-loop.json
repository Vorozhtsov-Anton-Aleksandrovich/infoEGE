{
  "lesson": "06-while-loop",
  "tasks": [
    {
      "id": "py06-1",
      "title": "Степени двойки",
      "statement": "Дано натуральное `n`. Выведи все степени двойки (1, 2, 4, 8, …), которые **не больше** `n`, каждую на отдельной строке.",
      "starterCode": "",
      "hint": "Начни с p = 1 и, пока p <= n, выводи p и удваивай его.",
      "tests": [
        {
          "input": "10\n",
          "hidden": false,
          "output": "1\n2\n4\n8"
        },
        {
          "input": "1\n",
          "hidden": true,
          "output": "1"
        },
        {
          "input": "64\n",
          "hidden": true,
          "output": "1\n2\n4\n8\n16\n32\n64"
        },
        {
          "input": "1000000\n",
          "hidden": true,
          "output": "1\n2\n4\n8\n16\n32\n64\n128\n256\n512\n1024\n2048\n4096\n8192\n16384\n32768\n65536\n131072\n262144\n524288"
        }
      ]
    },
    {
      "id": "py06-2",
      "title": "Количество цифр",
      "statement": "Дано целое неотрицательное число. Выведи количество цифр в нём, используя `while` (без `str` и `len`).",
      "starterCode": "",
      "hint": "Аккуратно с нулём: в числе 0 одна цифра. Можно начать счётчик с 1 и отрезать цифры, пока n >= 10.",
      "tests": [
        {
          "input": "2025\n",
          "hidden": false,
          "output": "4"
        },
        {
          "input": "0\n",
          "hidden": false,
          "output": "1"
        },
        {
          "input": "9\n",
          "hidden": true,
          "output": "1"
        },
        {
          "input": "10\n",
          "hidden": true,
          "output": "2"
        },
        {
          "input": "123456789012345\n",
          "hidden": true,
          "output": "15"
        }
      ]
    },
    {
      "id": "py06-3",
      "title": "Сумма цифр",
      "statement": "Дано натуральное число (может быть очень большим). Выведи сумму его цифр, используя `while`, `%` и `//`.",
      "starterCode": "",
      "hint": "Раздел 4 урока: s += n % 10, затем n //= 10, пока n > 0.",
      "tests": [
        {
          "input": "2025\n",
          "hidden": false,
          "output": "9"
        },
        {
          "input": "7\n",
          "hidden": true,
          "output": "7"
        },
        {
          "input": "1000000\n",
          "hidden": true,
          "output": "1"
        },
        {
          "input": "99999999999999999999\n",
          "hidden": true,
          "output": "180"
        }
      ]
    },
    {
      "id": "py06-4",
      "title": "Простое число",
      "statement": "Дано натуральное `n` (n ≤ 10⁹). Выведи `YES`, если оно простое, иначе `NO`. Перебирай делители только до √n, иначе будет слишком долго.",
      "starterCode": "",
      "hint": "while d * d <= n — это и есть «до корня». Не забудь, что 1 — не простое число.",
      "tests": [
        {
          "input": "7\n",
          "hidden": false,
          "output": "YES"
        },
        {
          "input": "1\n",
          "hidden": false,
          "output": "NO"
        },
        {
          "input": "2\n",
          "hidden": true,
          "output": "YES"
        },
        {
          "input": "91\n",
          "hidden": true,
          "output": "NO"
        },
        {
          "input": "999999937\n",
          "hidden": true,
          "output": "YES"
        },
        {
          "input": "1000000000\n",
          "hidden": true,
          "output": "NO"
        }
      ]
    },
    {
      "id": "py06-5",
      "title": "Числа Фибоначчи",
      "statement": "F₁ = F₂ = 1, каждое следующее — сумма двух предыдущих: 1, 1, 2, 3, 5, 8, … Дано `n` (1 ≤ n ≤ 200). Выведи Fₙ.",
      "starterCode": "",
      "hint": "Храни два последних числа и сдвигай их: a, b = b, a + b.",
      "tests": [
        {
          "input": "6\n",
          "hidden": false,
          "output": "8"
        },
        {
          "input": "1\n",
          "hidden": true,
          "output": "1"
        },
        {
          "input": "2\n",
          "hidden": true,
          "output": "1"
        },
        {
          "input": "50\n",
          "hidden": true,
          "output": "12586269025"
        },
        {
          "input": "200\n",
          "hidden": true,
          "output": "280571172992510140037611932413038677189525"
        }
      ]
    }
  ]
}