      "id": "py08-1",
      "title": "Простые на отрезке",
      "statement": "Напиши функцию `is_prime(n)`. В одной строке даны `a b`. Выведи количество простых чисел на отрезке [a; b].",
      "starterCode": "def is_prime(n):\n    # верни True, если n простое\n    pass\n\n\na, b = map(int, input().split())\n",
      "hint": "",
      "tests": [
        {
          "input": "1 10\n",
          "hidden": false,
          "output": "4"
        },
        {
          "input": "1 1\n",
          "hidden": true,
          "output": "0"
        },
        {
          "input": "2 2\n",
          "hidden": true,
          "output": "1"
        },
        {
          "input": "1 10000\n",
          "hidden": true,
          "output": "1229"
        },
        {
          "input": "100000 101000\n",
          "hidden": true,
          "output": "81"
        }
      ]
    },
    {
