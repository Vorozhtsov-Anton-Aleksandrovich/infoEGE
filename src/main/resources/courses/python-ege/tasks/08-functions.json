        {
          "input": "1\n",
          "hidden": true,
          "output": "1"
        },
        {
          "input": "10\n",
          "hidden": true,
          "output": "109"
        },
        {
          "input": "300\n",
          "hidden": true,
          "output": "90299"
        }
      ]
    },
