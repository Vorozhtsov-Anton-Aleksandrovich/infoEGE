          "output": "0"
        },
        {
          "input": "1 0 1\n",
          "hidden": true,
          "output": "0"
        },
        {
          "input": "1 1 0\n",
          "hidden": true,
          "output": "1"
        },
        {
          "input": "1 1 1\n",
          "hidden": true,
