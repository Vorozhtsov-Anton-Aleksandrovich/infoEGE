{
  "lesson": "04-conditions",
  "tasks": [
    {
      "id": "py04-1",
      "title": "Чётное или нечётное",
      "statement": "Дано целое число. Выведи `EVEN`, если оно чётное, и `ODD`, если нечётное.",
      "starterCode": "",
      "hint": "",
      "tests": [
        {
          "input": "4\n",
          "hidden": false,
          "output": "EVEN"
        },
        {
          "input": "7\n",
          "hidden": true,
          "output": "ODD"
        },
        {
          "input": "0\n",
          "hidden": true,
          "output": "EVEN"
        },
        {
          "input": "-3\n",
          "hidden": true,
          "output": "ODD"
        }
      ]
    },
    {
      "id": "py04-2",
      "title": "Максимум из трёх",
      "statement": "В одной строке даны три целых числа. Выведи наибольшее. Реши через `if`, без `max`.",
      "starterCode": "",
      "hint": "",
      "tests": [
        {
          "input": "1 5 3\n",
          "hidden": false,
          "output": "5"
        },
        {
          "input": "9 2 4\n",
          "hidden": true,
          "output": "9"
        },
        {
          "input": "1 2 9\n",
          "hidden": true,
          "output": "9"
        },
        {
          "input": "-1 -2 -3\n",
          "hidden": true,
          "output": "-1"
        },
        {
          "input": "5 5 5\n",
          "hidden": true,
          "output": "5"
        }
      ]
    },
    {
      "id": "py04-3",
      "title": "Високосный год",
      "statement": "Год високосный, если он делится на 4, но не делится на 100, **или** делится на 400. Выведи `YES`, если год високосный, иначе `NO`.",
      "starterCode": "",
      "hint": "",
      "tests": [
        {
          "input": "2024\n",
          "hidden": false,
          "output": "YES"
        },
        {
          "input": "1900\n",
          "hidden": false,
          "output": "NO"
        },
        {
          "input": "2000\n",
          "hidden": true,
          "output": "YES"
        },
        {
          "input": "2023\n",
          "hidden": true,
          "output": "NO"
        },
        {
          "input": "2100\n",
          "hidden": true,
          "output": "NO"
        }
      ]
    },
    {
      "id": "py04-4",
      "title": "Треугольник",
      "statement": "Даны три натуральных числа — длины отрезков (в одной строке). Можно ли из них сложить невырожденный треугольник? Выведи `YES` или `NO`. Каждая сторона должна быть строго меньше суммы двух других.",
      "starterCode": "",
      "hint": "",
      "tests": [
        {
          "input": "3 4 5\n",
          "hidden": false,
          "output": "YES"
        },
        {
          "input": "1 2 3\n",
          "hidden": false,
          "output": "NO"
        },
        {
          "input": "10 1 1\n",
          "hidden": true,
          "output": "NO"
        },
        {
          "input": "5 5 5\n",
          "hidden": true,
          "output": "YES"
        },
        {
          "input": "2 9 8\n",
          "hidden": true,
          "output": "YES"
        }
      ]
    },
    {
      "id": "py04-5",
      "title": "Координатная четверть",
      "statement": "Даны координаты точки `x y` (оба не равны 0). Выведи номер четверти (1–4), в которой лежит точка.",
      "starterCode": "",
      "hint": "",
      "tests": [
        {
          "input": "1 2\n",
          "hidden": false,
          "output": "1"
        },
        {
          "input": "-1 5\n",
          "hidden": true,
          "output": "2"
        },
        {
          "input": "-3 -3\n",
          "hidden": true,
          "output": "3"
        },
        {
          "input": "4 -9\n",
          "hidden": true,
          "output": "4"
        }
      ]
    },
    {
      "id": "py04-6",
      "title": "Логическая функция (задание 2)",
      "statement": "Даны значения логических переменных `x y z` (0 или 1). Вычисли `F = (x → y) ∧ (y ≡ ¬z)` и выведи `0` или `1`.",
      "starterCode": "",
      "hint": "Импликация x → y записывается как (not x) or y.",
      "tests": [
